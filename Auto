--// UNIVERSAL HIT FUNCTION \--
local function ForceHitTarget(tool, targetChar)
    if not tool or not targetChar then return end
    
    tool:Activate()

    local toolParts = {}
    for _, item in pairs(tool:GetDescendants()) do
        if item:IsA("BasePart") then
            table.insert(toolParts, item)
        elseif item:IsA("RemoteEvent") then
            pcall(function()
                item:FireServer(targetChar)
            end)
        end
    end

    local targetParts = {
        targetChar:FindFirstChild("HumanoidRootPart"),
        targetChar:FindFirstChild("Head"),
        targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
    }

    for _, tPart in pairs(targetParts) do
        if tPart then
            for _, toolPart in pairs(toolParts) do
                firetouchinterest(toolPart, tPart, 0)
                firetouchinterest(toolPart, tPart, 1)
            end
        end
    end
end

--// MAIN MAX SPEED LOOP (Strict Hand-Equipped Check) \--
RunService.Stepped:Connect(function()
    if Toggled then
        pcall(function()
            local myChar = player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end
            
            -- STRICT CHECK: Sirf tab chalega jab tool seedha CHARACTER ke hath mein ho (Backpack se nahi uthayega)
            local tool = myChar:FindFirstChildOfClass("Tool")
            
            if tool then
                local allPlayers = Players:GetPlayers()
                for i = 1, #allPlayers do
                    local v = allPlayers[i]
                    
                    if v ~= player and v.Character and v.Character:FindFirstChild("Humanoid") then
                        local targetHum = v.Character.Humanoid
                        local targetRoot = v.Character:FindFirstChild("HumanoidRootPart")
                        
                        if targetHum.Health > 0 and targetRoot and not v.Character:FindFirstChildOfClass("ForceField") then
                            local dist = (myRoot.Position - targetRoot.Position).Magnitude
                            
                            if dist <= range then
                                ForceHitTarget(tool, v.Character)
                            end
                        end
                    end
                end
            end
        end)
    end
end)
